{
  "manifest_version": 3,
  "name": "Songsterr Classic — July preview",
  "version": "0.1.0",
  "description": "Opt into the archived July interface on one Songsterr tab. Experimental read-only compatibility preview.",
  "permissions": ["activeTab", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://www.songsterr.com/*", "https://*.songsterr.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Songsterr Classic"},
  "web_accessible_resources": [{
    "resources": ["bootstrap.mjs", "compat.mjs", "vendor/*"],
    "matches": ["https://www.songsterr.com/*", "https://static3.songsterr.com/*"]
  }]
}
